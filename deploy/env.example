# 서버(/opt/debate/.env) 설정 예시. 실제 키를 채워 넣고 커밋하지 말 것.

# ── LLM (연구실 vLLM 을 SSH 리버스 터널로 연결) ──────────────────────────
VLLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
LLM_API_KEY=fake
# 심사(judge)용을 분리하려면 지정. 미지정 시 VLLM_BASE_URL 을 그대로 쓴다.
# JUDGE_VLLM_BASE_URL=http://127.0.0.1:8000/v1

# ── 외부 서비스 ────────────────────────────────────────────────────────
TAVILY_API_KEY=
PINECONE_API_KEY=

# ── 앱 ────────────────────────────────────────────────────────────────
# nginx 가 같은 도메인에서 프록시하면 CORS 는 필요 없지만, 다른 도메인에서
# 프론트를 서빙한다면 해당 도메인만 허용할 것 (기본값 "*" 는 전체 허용).
CORS_ALLOW_ORIGINS=https://example.com

# 수집 DB 위치 (미지정 시 <프로젝트>/data/sessions.db)
# DEBATE_DB_PATH=/opt/debate/data/sessions.db
